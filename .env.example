# Copia este archivo como .env.local y completa los valores.
# Ambos son públicos (van en el navegador). NUNCA pongas aquí claves privadas ni el App Secret de Privy.

# App ID de Privy (dashboard.privy.io → tu app → Settings). Puede ser el mismo de MuSecure.
VITE_PRIVY_APP_ID=

# Cuenta del contrato de beats en NEAR testnet.
VITE_NEAR_CONTRACT=musecure-beats-favio.testnet

# --- Solo servidor (sin prefijo VITE_, nunca llega al navegador) ---
# API key de Lighthouse para subir el audio y el proyecto a IPFS (files.lighthouse.storage → API Key).
LIGHTHOUSE_API_KEY=

# --- Activación automática de cuentas (solo servidor) ---
# Cuenta de testnet que regala 0,05 NEAR a cada usuario nuevo de Privy.
NEAR_SPONSOR_ACCOUNT_ID=
# Clave privada de esa cuenta: campo "private_key" de ~/.near-credentials/testnet/<cuenta>.json
NEAR_SPONSOR_PRIVATE_KEY=
# Endpoint JWKS de Privy (dashboard → Configuration → App settings → JWT endpoint). Es público.
PRIVY_JWKS_URL=
# Alternativa al endpoint: la verification key en PEM, en una sola línea reemplazando los saltos por \n.
# PRIVY_VERIFICATION_KEY=

# --- Créditos por email (solo servidor) ---
# App Secret de Privy: crea de antemano la cuenta NEAR de un colaborador a partir de su email.
# Es el mismo que usa MuSecure en Vercel. NUNCA con prefijo VITE_ ni en el código.
PRIVY_APP_SECRET=
